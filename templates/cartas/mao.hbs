<div class="cmb-mao {{#unless pode}}bloqueada{{/unless}}">
  {{#unless vazio}}
  <div class="cmb-mao-info">
    <span class="cmb-mao-monte" data-tooltip="{{localize 'COMBATE.Cartas.mao.monte'}}"><i class="fa-solid fa-layer-group"></i> {{monte}}</span>
    {{#if mov}}<span class="cmb-mao-mov" data-tooltip="{{localize 'COMBATE.Cartas.mao.mov'}}"><i class="fa-solid fa-shoe-prints"></i> +{{mov}}</span>{{/if}}
    {{#if menos}}<span class="cmb-mao-menos" data-tooltip="{{localize 'COMBATE.Cartas.mao.menos'}}"><i class="fa-solid fa-heart-crack"></i> −{{menos}}</span>{{/if}}
    {{#if guardar}}<span class="cmb-mao-ajuda" data-tooltip="{{dicaGuardar}}"><i class="fa-solid fa-circle-info"></i></span>{{/if}}
  </div>

  <div class="cmb-mao-leque">
    {{#each cartas}}
    <button type="button" class="cmb-mao-carta {{#if pilha}}pilha{{/if}}" data-action="jogar" data-uid="{{uid}}" style="{{estilo}}"
            data-tooltip="{{dica}}" data-tooltip-direction="UP">{{#if pilha}}<span class="cmb-pilha-atras"></span>{{/if}}{{{html}}}{{#if pilha}}<span class="cmb-pilha-conta">×{{pilha}}</span>{{/if}}</button>
    {{/each}}
    {{#if vaziaMao}}<p class="cmb-mao-vazia">{{localize "COMBATE.Cartas.mao.vazia"}}</p>{{/if}}
  </div>

  <div class="cmb-mao-zonas">
    {{#if guardar}}
    <div class="cmb-zona guardada">
      <span class="cmb-zona-rotulo" data-tooltip="{{localize 'COMBATE.Cartas.mao.zonaGuardadaDica'}}"><i class="fa-solid fa-bookmark"></i> {{localize "COMBATE.Cartas.mao.zonaGuardada"}}</span>
      <div class="cmb-zona-slot">{{#if guardadaHTML}}<span class="cmb-zona-carta" data-tooltip="{{guardadaDica}}">{{{guardadaHTML}}}</span>{{else}}<span class="cmb-zona-vazia" data-tooltip="{{guardadaDica}}"></span>{{/if}}</div>
    </div>
    {{/if}}
    <div class="cmb-zona reacao" data-tooltip="{{localize 'COMBATE.Cartas.mao.zonaReacaoDica'}}">
      <span class="cmb-zona-rotulo"><i class="fa-solid fa-rotate-left"></i> {{localize "COMBATE.Cartas.mao.zonaReacao"}}</span>
      <div class="cmb-zona-slot">{{#if armadilhaHTML}}{{{armadilhaHTML}}}{{else}}<span class="cmb-zona-vazia"></span>{{/if}}</div>
    </div>
    <div class="cmb-zona defesa">
      <span class="cmb-zona-rotulo" data-tooltip="{{localize 'COMBATE.Cartas.mao.zonaDefesaDica'}}"><i class="fa-solid fa-shield-halved"></i> {{localize "COMBATE.Cartas.mao.zonaDefesa"}}</span>
      <div class="cmb-zona-slot">
        {{#each defesas}}<span class="cmb-zona-carta" data-tooltip="{{dica}}">{{{html}}}</span>{{else}}<span class="cmb-zona-vazia" data-tooltip="{{localize 'COMBATE.Cartas.mao.zonaDefesaDica'}}"></span>{{/each}}
      </div>
    </div>
  </div>
  {{/unless}}
</div>
