<div class="cmb-mao {{#unless pode}}bloqueada{{/unless}}">
  {{#unless vazio}}
  <div class="cmb-mao-info">
    <span class="cmb-mao-monte" data-tooltip="{{localize 'COMBATE.Cartas.mao.monte'}}"><i class="fa-solid fa-layer-group"></i> {{monte}}</span>
    {{#if mov}}<span class="cmb-mao-mov" data-tooltip="{{localize 'COMBATE.Cartas.mao.mov'}}"><i class="fa-solid fa-shoe-prints"></i> +{{mov}}</span>{{/if}}
    {{#if menos}}<span class="cmb-mao-menos" data-tooltip="{{localize 'COMBATE.Cartas.mao.menos'}}"><i class="fa-solid fa-heart-crack"></i> −{{menos}}</span>{{/if}}
    {{#if guardar}}<span class="cmb-mao-ajuda" data-tooltip="{{dicaGuardar}}"><i class="fa-solid fa-circle-info"></i></span>{{/if}}
  </div>

  <div class="cmb-mao-leque">
    {{#each cartas}}
    <button type="button" class="cmb-mao-carta" data-action="jogar" data-uid="{{uid}}" style="{{estilo}}"
            data-tooltip="{{dica}}" data-tooltip-direction="UP">{{{html}}}</button>
    {{/each}}
    {{#if vaziaMao}}<p class="cmb-mao-vazia">{{localize "COMBATE.Cartas.mao.vazia"}}</p>{{/if}}
  </div>

  {{#if armadilha}}
  <div class="cmb-mao-armadilha" data-tooltip="{{localize 'COMBATE.Cartas.mao.armadilha'}}">{{{armadilhaHTML}}}</div>
  {{/if}}
  {{/unless}}
</div>
