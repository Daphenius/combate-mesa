<button type="button" class="cmb-carta {{#if esgotado}}esgotado{{/if}}" data-action="usarItem" data-item-id="{{id}}"
        data-tooltip="{{tooltip}}" data-tooltip-class="dnd5e2 dnd5e-tooltip item-tooltip" data-tooltip-direction="UP">
  <span class="cmb-carta-arte">
    <img src="{{img}}" alt="">
    <i class="cmb-carta-selo {{selo}}" aria-label="{{seloNome}}"></i>
    {{#if usos}}<span class="cmb-carta-usos">{{usos}}</span>{{/if}}
  </span>
  <span class="cmb-carta-nome">{{nome}}</span>
</button>
