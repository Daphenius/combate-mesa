<div class="cm-barra {{#if minimizada}}minimizada{{/if}} {{#if seuTurno}}seu-turno{{/if}} {{#if modoCartas}}cm-modo-cartas{{/if}}">
  {{#unless vazio}}
  <header class="cm-barra-topo">
    <a class="cm-barra-retrato" data-action="abrirFicha" data-tooltip="{{localize 'COMBATE.Barra.ficha'}}"><img src="{{img}}" alt=""></a>
    <div class="cm-barra-nome">
      <strong>{{nome}}</strong>
      <span class="cm-barra-estado">{{#if seuTurno}}{{localize "COMBATE.Barra.seuTurno"}}{{else}}{{localize "COMBATE.Barra.aguardando"}}{{/if}}</span>
    </div>

    <div class="cm-selos">
      {{#unless modoCartas}}
      {{#each selos}}
      <button type="button" class="cm-selo {{id}} {{#if gasto}}gasto{{/if}}" data-action="selo" data-selo="{{id}}" data-tooltip="{{nome}}">
        <i class="{{icone}}"></i><span>{{curto}}</span>
      </button>
      {{/each}}
      {{/unless}}
      {{#if mov}}
      <div class="cm-movimento {{#if mov.disparada}}disparada{{/if}}" data-tooltip="{{localize 'COMBATE.Barra.movimento'}}">
        <i class="fa-solid fa-shoe-prints"></i>
        <div class="cm-mov-barra"><span style="width: {{mov.pct}}%"></span></div>
        <span class="cm-mov-num">{{mov.resta}}<small>/{{mov.total}} {{mov.unidade}}</small></span>
      </div>
      {{/if}}
    </div>

    <div class="cm-barra-botoes">
      {{#if podeTerminar}}
      <button type="button" class="cm-terminar" data-action="terminarTurno" data-tooltip="{{localize 'COMBATE.Barra.terminar'}}"><i class="fa-solid fa-check"></i><span>{{localize "COMBATE.Barra.terminarCurto"}}</span></button>
      {{/if}}
      {{#unless modoCartas}}
      <button type="button" class="cm-min" data-action="minimizar" data-tooltip="{{localize 'COMBATE.Barra.minimizar'}}">
        <i class="fa-solid {{#if minimizada}}fa-chevron-up{{else}}fa-chevron-down{{/if}}"></i>
      </button>
      {{/unless}}
    </div>
  </header>

  {{#unless modoCartas}}{{#unless minimizada}}
  <nav class="cm-abas">
    {{#each abas}}
    <button type="button" class="{{#if ativa}}ativa{{/if}}" data-action="aba" data-aba="{{id}}" data-tooltip="{{nome}}"><i class="{{icone}}"></i><span>{{nome}}</span></button>
    {{/each}}
  </nav>

  <div class="cm-cartas">
    {{#if basicas}}
      {{#each basicas}}
      <button type="button" class="cm-carta basica {{#if esgotado}}esgotado{{/if}}" data-action="usarBasica" data-acao="{{id}}" data-tooltip="{{dica}}">
        <span class="cm-carta-arte"><i class="cm-carta-icone {{icone}}"></i><i class="cm-carta-selo {{selo}}"></i></span>
        <span class="cm-carta-nome">{{nome}}</span>
      </button>
      {{/each}}
    {{else if grupos}}
      {{#each grupos}}
      <div class="cm-grupo">
        <div class="cm-grupo-rotulo">
          <span>{{rotulo}}</span>
          {{#if espacos}}<span class="cm-espacos">{{#each espacos}}<i class="{{#if cheio}}cheio{{/if}}"></i>{{/each}}</span>{{/if}}
        </div>
        <div class="cm-grupo-cartas">{{#each cartas}}{{> "modules/combate-mesa/templates/carta.hbs" this}}{{/each}}</div>
      </div>
      {{/each}}
    {{else}}
      {{#each cartas}}{{> "modules/combate-mesa/templates/carta.hbs" this}}{{/each}}
      {{#if vazioAba}}<p class="cm-vazio">{{localize "COMBATE.Barra.vazio"}}</p>{{/if}}
    {{/if}}
  </div>
  {{/unless}}{{/unless}}
  {{/unless}}
</div>
