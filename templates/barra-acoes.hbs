<div class="cmb-barra tam-{{tamanho}} {{#if minimizada}}minimizada{{/if}} {{#if seuTurno}}seu-turno{{/if}} {{#if modoCartas}}cmb-modo-cartas{{/if}}">
  {{#unless vazio}}
  <header class="cmb-barra-topo">
    <span class="cmb-barra-alca" data-tooltip="{{localize 'COMBATE.Barra.mover'}}"><i class="fa-solid fa-grip-vertical"></i></span>
    <a class="cmb-barra-retrato" data-action="abrirFicha" data-tooltip="{{localize 'COMBATE.Barra.ficha'}}"><img src="{{img}}" alt=""></a>
    <div class="cmb-barra-nome">
      <strong>{{nome}}</strong>
      <span class="cmb-barra-estado">{{#if seuTurno}}{{localize "COMBATE.Barra.seuTurno"}}{{else}}{{localize "COMBATE.Barra.aguardando"}}{{/if}}</span>
    </div>

    <div class="cmb-selos">
      {{#unless modoCartas}}
      {{#each selos}}
      <button type="button" class="cmb-selo {{id}} {{#if gasto}}gasto{{/if}}" data-action="selo" data-selo="{{id}}" data-tooltip="{{nome}}">
        <i class="{{icone}}"></i><span>{{curto}}</span>
      </button>
      {{/each}}
      {{#if ataques}}
      <span class="cmb-ataques {{#if ataques.gasto}}gasto{{/if}}" data-tooltip="{{ataques.dica}}">
        <i class="fa-solid fa-khanda"></i><span>{{ataques.total}}</span>
      </span>
      {{/if}}
      {{#if multi}}
      <button type="button" class="cmb-multi {{#if multi.esgotado}}gasto{{/if}}" data-action="multiataque" data-tooltip="{{multi.dica}}">
        <i class="fa-solid fa-burst"></i><span>+{{multi.extras}}</span><small>{{multi.restam}}/{{multi.usos}}</small>
      </button>
      {{/if}}
      {{/unless}}
      {{#if mov}}
      <div class="cmb-movimento {{#if mov.disparada}}disparada{{/if}}" data-tooltip="{{localize 'COMBATE.Barra.movimento'}}">
        <i class="fa-solid fa-shoe-prints"></i>
        <div class="cmb-mov-barra"><span style="width: {{mov.pct}}%"></span></div>
        <span class="cmb-mov-num">{{mov.resta}}<small>/{{mov.total}} {{mov.unidade}}</small></span>
      </div>
      {{/if}}
    </div>

    <div class="cmb-barra-botoes">
      {{#if podeTerminar}}
      <button type="button" class="cmb-terminar" data-action="terminarTurno" data-tooltip="{{localize 'COMBATE.Barra.terminar'}}"><i class="fa-solid fa-check"></i><span>{{localize "COMBATE.Barra.terminarCurto"}}</span></button>
      {{/if}}
      {{#unless modoCartas}}
      <button type="button" class="cmb-min" data-action="minimizar" data-tooltip="{{localize 'COMBATE.Barra.minimizar'}}">
        <i class="fa-solid {{#if minimizada}}fa-chevron-up{{else}}fa-chevron-down{{/if}}"></i>
      </button>
      {{/unless}}
    </div>
  </header>

  {{#unless modoCartas}}{{#unless minimizada}}
  <nav class="cmb-abas">
    {{#each abas}}
    <button type="button" class="{{#if ativa}}ativa{{/if}}" data-action="aba" data-aba="{{id}}" data-tooltip="{{nome}}"><i class="{{icone}}"></i><span>{{nome}}</span></button>
    {{/each}}
  </nav>

  {{#if busca}}
  <label class="cmb-busca">
    <i class="fa-solid fa-magnifying-glass"></i>
    <input type="search" value="{{filtro}}" placeholder="{{localize 'COMBATE.Barra.buscar'}}" autocomplete="off">
  </label>
  {{/if}}
  <div class="cmb-cartas aba-{{aba}}">
    {{#if basicas}}
      {{#each basicas}}
      <button type="button" class="cmb-carta basica {{#if esgotado}}esgotado{{/if}}" data-action="usarBasica" data-acao="{{id}}" data-tooltip="{{dica}}">
        <span class="cmb-carta-arte"><i class="cmb-carta-icone {{icone}}"></i><i class="cmb-carta-selo {{selo}}"></i></span>
        <span class="cmb-carta-nome">{{nome}}</span>
      </button>
      {{/each}}
    {{else if grupos}}
      {{#each grupos}}
      <div class="cmb-grupo">
        <div class="cmb-grupo-rotulo">
          <span>{{rotulo}}</span>
          {{#if espacos}}<span class="cmb-espacos">{{#each espacos}}<i class="{{#if cheio}}cheio{{/if}}"></i>{{/each}}</span>{{/if}}
        </div>
        <div class="cmb-grupo-cartas">{{#each cartas}}{{> "modules/combate-mesa/templates/carta.hbs" this}}{{/each}}</div>
      </div>
      {{/each}}
    {{else}}
      {{#each cartas}}{{> "modules/combate-mesa/templates/carta.hbs" this}}{{/each}}
      {{#if vazioAba}}<p class="cmb-vazio">{{#if (eq aba "bonus")}}{{localize "COMBATE.Barra.vazioBonus"}}{{else}}{{localize "COMBATE.Barra.vazio"}}{{/if}}</p>{{/if}}
    {{/if}}
  </div>
  {{/unless}}{{/unless}}
  {{/unless}}
</div>
